# ==============================================================================
#                      PRODUCTIVITY PLATFORM ENV CONFIGURATION
# ==============================================================================
# This file serves as a template/documentation for configuring your local
# development environment and production deployment. 
#
# DO NOT commit actual secrets (API keys, passwords, credentials) to version control.
# Create a copy of this file named `.env` for local development.
# For production, define these variables in your platform settings (e.g. Vercel, Render, Railway).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE BACKEND VARIABLES (Secret / Server-side)
# ------------------------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI API calls.
# - Where to obtain: Google AI Studio (https://aistudio.google.com/)
# - Security: STRICTLY SECRET. Never expose to client-side code.
GEMINI_API_KEY="AI_STUDIO_GEMINI_KEY"

# APP_URL: The public URL of your deployed application.
# - Example: "https://your-app-name.railway.app" or "http://localhost:3000"
# - Why needed: Used for self-referential links, CORS verification, and callback redirect matches.
# - Security: Publicly visible config, but kept on server.
APP_URL="http://localhost:3000"

# PORT: The port the Express backend server will bind to.
# - Default: 3000
# - Security: Internal server configuration.
PORT=3000

# CURRENT_TIME: Custom ISO timestamp override for testing and time-based debugging.
# - Default: (Omit this variable in production to let it use the live system clock dynamically)
# - Why needed: Overrides system clock to evaluate time-of-day features deterministically.
# CURRENT_TIME="2026-06-30T09:03:03-07:00"


# ------------------------------------------------------------------------------
# 2. SERVER-SIDE FIREBASE CREDENTIALS (Secret / Server-side)
# ------------------------------------------------------------------------------
# These are used by the Express backend (`server/dbStore.ts`) to authorize Firestore database read/write.
# - Where to obtain: Firebase Console > Project Settings > General (Web App configuration)
# - Security: Private keys, do not expose to browser.

FIREBASE_API_KEY="AI_Secret_Key_For_Firebase_Backend"
FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="123456789012"
FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
FIREBASE_MEASUREMENT_ID="G-ABCDEF1234"
FIREBASE_DATABASE_ID="remixed-firestore-database-id"


# ------------------------------------------------------------------------------
# 3. CLIENT-SIDE PUBLIC VARIABLES (Public / Prefixed with VITE_)
# ------------------------------------------------------------------------------
# These are compiled by Vite into the frontend bundle. They are visible in the browser source code.
# - Security: Safe for public values. Never put actual backend/provider credentials here!

# VITE_API_BASE_URL: The root URL of your deployed Express backend API.
# - Default: (Leave blank if frontend and backend are hosted on the same domain/server, e.g. a monolithic deployment on Render/Railway)
# - Why needed: If your frontend is deployed separately (e.g. static host on Vercel or Netlify) and talks to a backend on Render or Railway, specify the backend URL.
# - Example: "https://my-backend-server.onrender.com"
VITE_API_BASE_URL=""

# VITE_FIREBASE_*: Client-side Firebase authorization config.
# - Why needed: Allows client-side popup login with Google via Firebase Auth.
# - Security: Safe for public client-side Firebase initialization.
VITE_FIREBASE_API_KEY="AI_Secret_Key_For_Firebase_Backend"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_MEASUREMENT_ID="G-ABCDEF1234"
VITE_FIREBASE_DATABASE_ID="remixed-firestore-database-id"
